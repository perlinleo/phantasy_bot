# Keep this file token-free. Copy it to .env locally; never commit .env.
# BOT_TOKEN is required only by the bot role, not migration/worker.
BOT_TOKEN=replace-me
OWNER_TELEGRAM_ID=123456789
DATA_DIR=/data
ENABLED_PLUGINS=text_card
# Optional characters-v1 pack for glamour_letters/comedy_stage; use an absolute local path.
# PLUGIN_ASSETS_DIR=/absolute/path/to/phantasy_bot/output/plugin-assets/v1
# With Docker, add compose.characters.yaml; it mounts the pack read-only for bot and worker.
TZ=UTC
JOB_TIMEOUT_SECONDS=300
RETENTION_DAYS=7
MAX_QUEUE_SIZE=20
MAX_USER_UNFINISHED=3
LOG_LEVEL=INFO
